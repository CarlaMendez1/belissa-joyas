# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=belissa
DB_USER=postgres
DB_PASS=
# true en bases gestionadas (Neon, Render, Supabase...)
DB_SSL=false

# Seguridad: una cadena larga y aleatoria, distinta en cada entorno
JWT_SECRET=

# URLs públicas
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001
# Opcional: si se define, reemplaza a BACKEND_PUBLIC_URL + /pago/webhook
NOTIFICATION_URL=

# Mercado Pago
MP_ACCESS_TOKEN=

# Imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mails
EMAIL_HABILITADO=false
EMAIL_USER=
EMAIL_PASS=

# Administrador principal (el único que puede agregar o quitar administradores)
ADMIN_PRINCIPAL_EMAIL=
